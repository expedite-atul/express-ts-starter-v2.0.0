{
  "name": "employee-management-api",
  "version": "0.1.0",
  "description": "Secure Employee Management System: Express 5 + PostgreSQL REST API",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(48).toString('base64url'))\"",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "db:migrate": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "db:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "db:migration:show": "npm run typeorm -- migration:show -d src/config/data-source.ts",
    "db:migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts --pretty",
    "db:migration:create": "npm run typeorm -- migration:create",
    "db:seed": "tsx seeds/seed.ts",
    "db:reset": "npm run typeorm -- schema:drop -d src/config/data-source.ts && npm run db:migrate && npm run db:seed",
    "db:migrate:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/src/config/data-source.js",
    "retention:run": "tsx scripts/run-retention.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
