# Template for your local .env file:   cp .env.example .env
#
# - .env is git-ignored. Never commit real credentials or secrets.
# - Use different values for every environment (development, test, production).
# - Deployed environments get these from the platform's secrets manager, not from a file.
# - Every variable is required. The app refuses to start if one is missing or invalid
#   (see src/config/env.ts). Add new variables there AND here.

# --- Runtime ---
# development | test | production
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/employee_management

# --- Access tokens (JWT) ---
# At least 32 random characters. Generate one with:  npm run secret
# (The placeholder below is rejected on purpose, so the app will not start until you replace it.)
JWT_ACCESS_SECRET=replace_with_a_secure_random_secret
# Lifetime of an access token: e.g. 900s, 15m or 1h. Maximum 1h.
JWT_ACCESS_TTL=15m
# Written into every token and checked on every request.
JWT_ISSUER=employee-management-api
JWT_AUDIENCE=employee-management-clients

# --- Refresh tokens ---
# 1 to 90 days.
REFRESH_TOKEN_TTL_DAYS=7

# --- HTTP security ---
# Comma-separated browser origins allowed by CORS. Exact origins only: no path, no "*".
CORS_ORIGINS=http://localhost:5173
# Default rate limit: at most RATE_LIMIT_MAX_REQUESTS requests per RATE_LIMIT_WINDOW_MS per client.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
