{
  // Used by the editor, `npm run typecheck`, ESLint and the test runner. It checks every
  // TypeScript file in the project, tests included, and emits nothing.
  // `npm run build` uses tsconfig.build.json, which extends this file.
  "compilerOptions": {
    /* Runtime: Node.js 22+ running native ES modules ("type": "module" in package.json) */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    /* Imports: write the file you can see, e.g. `import { env } from './config/env.ts'`.
       tsx runs .ts directly in development, and `tsc` rewrites the import to `.js` in dist/. */
    "rewriteRelativeImportExtensions": true,
    // Type-only imports must say so (`import type { Request } from 'express'`), so the
    // emitted JavaScript never imports something that only exists at compile time.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    /* TypeORM entities use decorators (@Entity, @Column, ...).
       Every @Column states its database type explicitly, so `emitDecoratorMetadata`
       is not needed (and tsx/esbuild could not emit it anyway). */
    "experimentalDecorators": true,
    // Class fields keep TypeScript's classic semantics: a declared-but-unassigned entity
    // property does not become an own `undefined` property that hides ORM-managed values.
    "useDefineForClassFields": false,

    /* Type safety: strict on purpose. Most security bugs start as "this can't be undefined". */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["src", "migrations", "seeds", "scripts", "tests", "vitest.config.ts"]
}
